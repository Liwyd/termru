# Copy this file to `.env` next to `compose.yaml` and fill in the values.
# `.env` must never be committed: it holds the database password.

# --- required ---------------------------------------------------------------
# Password of the database role. Generate one with:
#   openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# --- database ---------------------------------------------------------------
POSTGRES_USER=termru
POSTGRES_DB=termru

# --- image ------------------------------------------------------------------
# The image the app service runs. The default points at the published image;
# override it to test a local build.
TERMRU_CLOUD_IMAGE=ghcr.io/liwyd/termru-cloud
TERMRU_CLOUD_VERSION=0.1.0

# --- server tuning (optional) -----------------------------------------------
TERMRU_ACCESS_TOKEN_TTL_SECS=3600
TERMRU_REFRESH_TOKEN_TTL_SECS=2592000
TERMRU_RATE_LIMIT_PER_MINUTE=120
TERMRU_LOGIN_MAX_FAILURES=5
TERMRU_LOGIN_LOCKOUT_SECS=900
TERMRU_REQUEST_TIMEOUT_SECS=30
TERMRU_MAX_BODY_BYTES=4194304
RUST_LOG=info
